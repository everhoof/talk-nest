{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@modules/(.*)$": "<rootDir>/../src/modules/$1"
  },
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.test.json"
      }
    ]
  },
  "setupFiles": ["<rootDir>/setup-env.ts"]
}
