{
  "name": "@everhoof/im_everhoof_api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "API for Everhoof Instant Messaging system",
  "repository": "git@github.com:everhoof/im_everhoof_api.git",
  "author": {
    "name": "Svyatoslav Fyodorov",
    "email": "intelrug@gmail.com",
    "url": "https://github.com/intelrug"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "keywords": [
    "everhoof",
    "radio",
    "chat",
    "im",
    "messenger"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "start:prod": "cross-env NODE_ENV=production node -r ./environment.js dist/main.js",
    "start:dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--require ./environment.js\" nest start --watch",
    "start:debug": "cross-env NODE_ENV=development NODE_OPTIONS=\"--require ./environment.js\" nest start --watch --debug",
    "build": "pnpm clean && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"*.{ts,js,json}\" \"database/**/*.{ts,js,json}\" \"src/**/*.{ts,js,json}\" \"test/**/*.{ts,js,json}\"",
    "lint": "eslint \"{src,database,scripts,test}/**/*.{ts,js}\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "pnpm test --watch",
    "test:cov": "pnpm test --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "pnpm test --config ./test/jest-e2e.json",
    "typeorm": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register -r ./environment.js ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "typeorm:prod": "cross-env NODE_ENV=production node -r ./environment.js ./node_modules/typeorm/cli.js -d ./dist/database/data-source.js",
    "typeorm:test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -r ./environment.js ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "seeder": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register -r ./environment.js ./node_modules/typeorm/cli.js -d ./src/database/seed-data-source.ts",
    "seeder:prod": "cross-env NODE_ENV=production node -r ./environment.js ./node_modules/typeorm/cli.js -d ./dist/database/seed-data-source.js",
    "seeder:test": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register -r ./environment.js ./node_modules/typeorm/cli.js -d ./src/database/seed-data-source.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@types/ws": "^8.2.2",
    "accesscontrol": "^2.2.1",
    "centrifuge": "^2.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^7.0.3",
    "dataloader": "^2.0.0",
    "donationalerts": "^1.0.1",
    "dotenv-flow": "^3.2.0",
    "express": "^5.1.0",
    "file-type": "^16.3.0",
    "form-data": "^3.0.0",
    "fs-extra": "^9.0.1",
    "global-agent": "^3.0.0",
    "gm": "^1.23.1",
    "got": "^11.8.0",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "handlebars": "^4.7.10",
    "image-size": "^0.9.7",
    "joi": "^17.5.0",
    "lodash": "^4.17.21",
    "luxon": "^1.25.0",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-anonymous": "^1.0.1",
    "passport-http-bearer": "^1.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.5.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.2",
    "subscriptions-transport-ws": "^0.11.0",
    "the-big-username-blacklist": "^1.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.9.0",
    "typeorm": "^0.3.31",
    "typescript": "~6.0.3",
    "ws": "^8.5.0",
    "xmlhttprequest": "^1.8.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.5.0",
    "@types/fs-extra": "^9.0.3",
    "@types/gm": "^1.18.9",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.165",
    "@types/luxon": "^1.25.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-anonymous": "^1.0.3",
    "@types/passport-http-bearer": "^1.0.35",
    "@types/passport-local": "^1.0.33",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "gh-pages": "^3.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "supertest": "^4.0.2",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.8.16"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@12.14.0"
}
